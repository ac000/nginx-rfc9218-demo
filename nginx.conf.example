# RFC9218 Priority Demo

# Generate test data file (256KB)
# dd if=/dev/urandom of=/path/to/demo/data.bin bs=1024 count=256

daemon off;
events {}

http {
    access_log /dev/stdout;
    error_log /dev/stderr;

    http2 on;
    http3 on;

    # Two origins so browser tests can force one protocol or the other:
    #   :8443   HTTP/2 only          (no QUIC listen, no Alt-Svc)
    #   :8444   HTTP/3 preferred     (QUIC listen + Alt-Svc: h3=":8444")

    server {
        listen 8443 ssl;
        listen [::1]:8443 ssl;
        server_name localhost;

        ssl_certificate     /path/to/cert.pem;
        ssl_certificate_key /path/to/key.pem;

        root /path/to/nginx-rfc9218-demo/;

        location / {
            index index.html;
        }

        location ~ ^/priority/([0-7])/data\.bin$ {
            add_header Priority "u=$1";
            rewrite ^ /data.bin break;
            add_header Cache-Control "no-store";
        }
    }

    server {
        listen 8444 ssl;
        listen [::1]:8444 ssl;
        listen 8444 quic reuseport;
        listen [::1]:8444 quic reuseport;
        server_name localhost;

        ssl_certificate     /path/to/cert.pem;
        ssl_certificate_key /path/to/key.pem;

        add_header Alt-Svc 'h3=":8444"; ma=86400';

        root /path/to/nginx-rfc9218-demo/;

        location / {
            index index.html;
        }

        location ~ ^/priority/([0-7])/data\.bin$ {
            add_header Priority "u=$1";
            rewrite ^ /data.bin break;
            add_header Cache-Control "no-store";
        }
    }
}
